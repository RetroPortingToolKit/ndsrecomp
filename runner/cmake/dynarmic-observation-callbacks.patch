+static void SynchronizeMemoryTicks(A32::UserCallbacks* callbacks, A32JitState* state) {
+    auto& stack = *state->memory_callback_stack;
+    const s64 prefix = static_cast<s64>(state->memory_callback_prefix);
+    stack.cycles_remaining -= prefix;
+    callbacks->AddTicks(static_cast<u64>(stack.cycles_to_run - stack.cycles_remaining));
+    const u64 remaining = callbacks->GetTicksRemaining();
+    stack.cycles_to_run = static_cast<s64>(remaining);
+    stack.cycles_remaining = static_cast<s64>(remaining) + prefix;
+}
+
+template<auto callback>
+static auto TimedMemoryRead(A32::UserCallbacks* callbacks, u32 address, A32JitState* state) {
+    SynchronizeMemoryTicks(callbacks, state);
+    const auto value = (callbacks->*callback)(address);
+    SynchronizeMemoryTicks(callbacks, state);
+    return value;
+}
+
+template<typename T, auto callback>
+static void TimedMemoryWrite(A32::UserCallbacks* callbacks, u32 address, T value, A32JitState* state) {
+    SynchronizeMemoryTicks(callbacks, state);
+    (callbacks->*callback)(address, value);
+    SynchronizeMemoryTicks(callbacks, state);
+}
+
+void A32EmitX64::EmitTimedMemoryPrelude(A32EmitContext& ctx, IR::Inst* inst, const Xbyak::Reg64& address, Xbyak::Label& untimed) {
+    const u32 mask = conf.memory_tick_address_mask;
+    const u32 match = conf.memory_tick_address_value;
+    ASSERT((match & mask) == match);
+    const u32 inverse = ~mask;
+    if ((inverse & (inverse + 1u)) == 0) {
+        // Upper contiguous masks need no scratch register or spill at all.
+        if (match != 0) { code.cmp(address.cvt32(), match); code.jb(untimed, code.T_NEAR); }
+        if ((match | inverse) != 0xFFFFFFFFu) { code.cmp(address.cvt32(), match | inverse); code.ja(untimed, code.T_NEAR); }
+    } else {
+        code.push(rax); code.mov(eax, address.cvt32()); code.and_(eax, mask); code.cmp(eax, match); code.pop(rax); code.jne(untimed, code.T_NEAR);
+    }
+    const u64 prefix = conf.memory_access_tick_prefix(ctx.block.Location().Value(), inst->GetArg(0).GetU64());
+    ASSERT(prefix <= 0x7FFFFFFFu);
+    code.mov(qword[r15 + offsetof(A32JitState, memory_callback_prefix)], static_cast<u32>(prefix));
+    code.push(rax);
+    code.lea(rax, ptr[rsp + sizeof(u64) + ABI_SHADOW_SPACE]);
+    code.mov(qword[r15 + offsetof(A32JitState, memory_callback_stack)], rax);
+    code.pop(rax);
+}
