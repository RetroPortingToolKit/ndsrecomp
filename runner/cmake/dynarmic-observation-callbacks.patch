+namespace {
+class ObservationEnv : public ArmTestEnv {
+public:
+    u64 elapsed{},deadline=std::numeric_limits<u64>::max();
+    std::vector<u64> observed,charges;
+    std::vector<u32> written;
+    A32::CpsrControlWriteResult action=A32::CpsrControlWriteResult::Continue;
+    unsigned controls{},fallbacks{};
+    u32 fallback_pc{},seen_cpsr{};
+    bool PreCodeReadHook(bool,u32 pc,A32::IREmitter& ir) override {
+        const u32 start=A32::LocationDescriptor{ir.block.Location()}.PC();
+        if(pc==12&&pc!=start){
+            ir.BranchWritePC(ir.Imm32(pc));
+            ir.SetTerm(IR::Term::CheckHalt{IR::Term::LinkBlock{ir.current_location}});
+            return false;
+        }
+        return true;
+    }
+    u32 MemoryRead32(u32 address) override {
+        observed.push_back(elapsed);
+        if((address&0xFF000000u)==0x04000000u)deadline=3;
+        return address^0x13579BDFu;
+    }
+    void MemoryWrite32(u32 address,u32 value) override {
+        observed.push_back(elapsed);written.push_back(value);
+        if((address&0xFF000000u)==0x04000000u)deadline=3;
+    }
+    void AddTicks(u64 ticks) override {charges.push_back(ticks);elapsed+=ticks;ticks_left=ticks<ticks_left?ticks_left-ticks:0;}
+    u64 GetTicksRemaining() override {return std::min(ticks_left,deadline>elapsed?deadline-elapsed:0);}
+    void InterpreterFallback(u32 pc,size_t n) override {fallback_pc=pc;fallbacks+=unsigned(n);}
+    A32::CpsrControlWriteResult CpsrControlWrite(u32,u32 current,u32) override {++controls;seen_cpsr=current;return action;}
+};
+u64 prefix(u64 block,u64 access){
+    const A32::LocationDescriptor b{IR::LocationDescriptor{block}},a{IR::LocationDescriptor{access}};
+    return (a.PC()-b.PC())/(b.TFlag()?2u:4u);
+}
+}
+
+TEST_CASE("arm: observation callback ticks and repeated LDM prefix", "[arm][A32][nds-observation]") {
+    for(bool pages:{false,true}) for(bool write:{false,true}) {
+        ObservationEnv env;
+        env.code_mem={0xE3A00001,0xE2800001,write?0xE881000Cu:0xE891000Cu,0xEAFFFFFE}; // MOV; ADD; LDM/STM r1,{r2,r3}
+        A32::UserConfig cfg{&env};cfg.arch_version=A32::ArchVersion::v5TE;
+        cfg.memory_access_tick_prefix=prefix;
+        cfg.memory_tick_address_mask=0xFF000000u;cfg.memory_tick_address_value=0x04000000u;
+        auto table=std::make_unique<std::array<u8*,A32::UserConfig::NUM_PAGE_TABLE_ENTRIES>>();table->fill(nullptr);
+        if(pages){cfg.page_table=table.get();cfg.page_table_read_only=true;}
+        A32::Jit jit{cfg};jit.SetCpsr(0xD3);jit.Regs()[1]=0x04000280;jit.Regs()[2]=0x12345678;jit.Regs()[3]=0x9ABCDEF0;env.ticks_left=100;
+        jit.Run();
+        REQUIRE(env.observed==std::vector<u64>{2,2});
+        REQUIRE(env.elapsed==3);REQUIRE(jit.Regs()[15]==12);
+        REQUIRE(jit.Regs()[0]==2);
+        if(write)REQUIRE(env.written==std::vector<u32>{0x12345678,0x9ABCDEF0});
+        else {REQUIRE(jit.Regs()[2]==(0x04000280u^0x13579BDFu));REQUIRE(jit.Regs()[3]==(0x04000284u^0x13579BDFu));}
+
+        // Nonmatching callback RAM retains the untimed callback path.
+        env.observed.clear();env.charges.clear();env.elapsed=0;env.deadline=std::numeric_limits<u64>::max();env.ticks_left=3;
+        jit.Regs()[15]=0;jit.Regs()[1]=0x02000280;jit.Run();
+        REQUIRE(env.observed==std::vector<u64>{0,0});
+        REQUIRE(env.charges==std::vector<u64>{3});REQUIRE(env.elapsed==3);
+        if(pages&&!write){
+            std::array<u8,4096> ram{};const u32 values[]={0x31415926,0x53589793};std::memcpy(ram.data()+0x280,values,sizeof(values));(*table)[0x02000]=ram.data();
+            env.observed.clear();env.charges.clear();env.elapsed=0;env.ticks_left=3;jit.Regs()[15]=0;jit.Run();
+            REQUIRE(env.observed.empty());REQUIRE(env.charges==std::vector<u64>{3});
+            REQUIRE(jit.Regs()[2]==values[0]);REQUIRE(jit.Regs()[3]==values[1]);
+        }
+    }
+}
+
+TEST_CASE("arm: guarded CPSR IRQ control retires or falls back once", "[arm][A32][nds-observation]") {
+    constexpr u32 original=0xA80001D3u,unmasked=0xA8000153u;
+    for(unsigned scenario=0;scenario<6;++scenario) {
+        ObservationEnv env;
+        env.code_mem={0xE10F2000,scenario==4?0xE321F053u:scenario==5?0x0121F000u:0xE121F000u,0xE10F3000,0xEAFFFFFE};
+        A32::UserConfig cfg{&env};cfg.arch_version=A32::ArchVersion::v5TE;cfg.enable_native_cpsr_control=true;
+        A32::Jit jit{cfg};jit.SetCpsr(original);jit.Regs()[0]=scenario==2?0x52u:scenario==3?0x73u:0x53u;jit.Regs()[3]=0x777u;
+        env.action=scenario==1?A32::CpsrControlWriteResult::Observe:A32::CpsrControlWriteResult::Continue;
+        env.ticks_left=scenario==1?10:3;jit.Run();
+        REQUIRE(jit.Regs()[2]==original);
+        if(scenario==2||scenario==3){
+            REQUIRE(env.fallbacks==1);REQUIRE(env.fallback_pc==4);REQUIRE(jit.Regs()[15]==4);
+            REQUIRE(jit.Cpsr()==original);REQUIRE(env.elapsed==1);REQUIRE(jit.Regs()[3]==0x777u);
+        }else if(scenario==1){
+            REQUIRE(env.fallbacks==0);REQUIRE(jit.Regs()[15]==8);REQUIRE(jit.Cpsr()==unmasked);
+            REQUIRE(env.elapsed==2);REQUIRE(jit.Regs()[3]==0x777u);
+        }else{
+            REQUIRE(env.fallbacks==0);REQUIRE(jit.Regs()[15]==12);REQUIRE(env.elapsed==3);
+            REQUIRE(jit.Cpsr()==(scenario==5?original:unmasked));
+            REQUIRE(jit.Regs()[3]==(scenario==5?original:unmasked));
+            REQUIRE(env.controls==(scenario==5?0u:1u));
+        }
+        if(env.controls)REQUIRE(env.seen_cpsr==original);
+    }
+}
+#endif
