+static u32 CpsrControlWrite(A32JitState* state, A32::UserCallbacks* callbacks, u32 pc, u32 value) {
+    const u32 current = state->Cpsr();
+    const auto action = callbacks->CpsrControlWrite(pc, current, value);
+    const bool privileged = (current & 31u) != 0x10u;
+    const bool same_state = ((current ^ value) & 0x3Fu) == 0;
+    if (!privileged || !same_state || action == A32::CpsrControlWriteResult::Unsupported) {
+        state->Reg[15] = pc;
+        state->halt_reason |= static_cast<u32>(HaltReason::UserDefined1);
+        callbacks->InterpreterFallback(pc, 1);
+        return static_cast<u32>(A32::CpsrControlWriteResult::Unsupported);
+    }
+    // The control byte alone is written. NZCVQ, GE, E/T and all other
+    // storage remain authoritative, including a preceding native flag write.
+    state->cpsr_jaifm = (state->cpsr_jaifm & ~0xC0u) | (value & 0xC0u);
+    if (action == A32::CpsrControlWriteResult::Observe)
+        state->halt_reason |= static_cast<u32>(HaltReason::UserDefined1);
+    return static_cast<u32>(action);
+}
+
+void A32EmitX64::EmitA32CpsrControlWrite(A32EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 pc = args[0].GetImmediateU32();
+    ctx.reg_alloc.HostCall(nullptr, {}, {}, args[0], args[1]);
+    code.mov(code.ABI_PARAM1, r15);
+    code.mov(code.ABI_PARAM2, reinterpret_cast<u64>(conf.callbacks));
+    code.CallFunction(CpsrControlWrite);
+    Xbyak::Label retired;
+    code.cmp(code.ABI_RETURN.cvt32(), static_cast<u32>(A32::CpsrControlWriteResult::Unsupported));
+    code.jne(retired);
+    // Failed admission has not retired this MSR. The ordinary block epilogue
+    // still charges the block, so refund precisely this last instruction.
+    if (conf.enable_cycle_counting) {
+        const auto word = conf.callbacks->MemoryReadCode(pc);
+        const u64 ticks = conf.callbacks->GetTicksForCode(false, pc, word.value_or(0));
+        ASSERT(ticks <= 0x7FFFFFFFu);
+        code.add(qword[rsp + ABI_SHADOW_SPACE + offsetof(StackLayout, cycles_remaining)], u32(ticks));
+    }
+    code.L(retired);
+}
