@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: 0BSD */
+#pragma once
+#include <cstdint>
+
+namespace Dynarmic {
+
+// Optional x64 lowering for a caller-owned, single-threaded physical RAM
+// transaction. Null pages, disabled windows, unaligned/ordered/exclusive
+// accesses and generation wrap retain the ordinary memory callbacks.
+// The caller must exclude executable/watched pages and every observer whose
+// effects are not represented here, and keep descriptors stable during Run.
+struct PublishedMemoryWrites {
+    struct Page {
+        std::uint8_t* data;
+        std::uint8_t* written;
+        std::uint32_t* generation;
+    };
+    // A 4KiB table for the 32-bit guest address space. An eligible descriptor
+    // publishes data, written-byte flags (1), generation (+1 for 8/16/32 bits)
+    // and the global coverage epoch as one instruction-owned transaction.
+    Page* const* pages;
+    const std::uint8_t* enabled;
+    std::uint64_t* write_epoch;
+    std::uint64_t* transactions;
+};
+
+} // namespace Dynarmic
